#!/usr/bin/env bash
# tclaude / tgrok / tcodex - Launch Claude Code, Grok, or Codex in a named tmux session
# Session name is derived from the current directory basename
# Usage: tclaude [--list|-l] [session-name]  (same usage for tgrok, tcodex)

set -euo pipefail

case "$(basename "$0")" in
    tclaude) TOOL="claude" ;;
    tgrok)   TOOL="grok" ;;
    tcodex)  TOOL="codex" ;;
    *)
        echo "Error: run this script as tclaude, tgrok, or tcodex." >&2
        exit 1
        ;;
esac

# Handle flags
case "${1:-}" in
    --list|-l)
        exec "t${TOOL}-list"
        ;;
esac

# Derive session name from current directory or use provided name
if [[ $# -ge 1 ]]; then
    SESSION_NAME="$1"
else
    # Try to derive name from git remote (org/repo format)
    if git rev-parse --is-inside-work-tree &>/dev/null; then
        remote_url=$(git remote get-url origin 2>/dev/null || true)
        if [[ -n "$remote_url" ]]; then
            # Extract org/repo from SSH or HTTPS URLs
            # git@github.com:BoutLabs/tclaude.git → BoutLabs/tclaude
            # https://github.com/BoutLabs/tclaude.git → BoutLabs/tclaude
            org_repo=$(echo "$remote_url" | sed -E 's#\.git$##; s#.*[:/]([^/]+/[^/]+)$#\1#')
            SESSION_NAME="${org_repo//\//-}"
            TAB_TITLE="${org_repo##*/}"
        else
            SESSION_NAME="$(basename "$PWD")"
        fi
    else
        SESSION_NAME="$(basename "$PWD")"
    fi
fi

# Suffix the session name with the tool when it isn't Claude, so tclaude, tgrok, and
# tcodex can each run their own session in the same project directory without colliding
# — this applies to explicit names too, since two tools launched with the same explicit
# name would otherwise attach to each other's sessions instead of starting their own
if [[ "$TOOL" != "claude" ]]; then
    SESSION_NAME="${SESSION_NAME}-${TOOL}"
    TAB_TITLE="${TAB_TITLE:-$(basename "$PWD")} (${TOOL})"
fi

# tmux doesn't allow dots in session names
SESSION_NAME="${SESSION_NAME//./-}"

# Check if session already exists
if tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
    echo "Session '$SESSION_NAME' already exists. Attaching..."
    exec tmux attach-session -t "=$SESSION_NAME"
fi

# Set up logging
LOG_DIR="$HOME/.local/share/t${TOOL}/logs"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/${SESSION_NAME}-$(date +%Y%m%d-%H%M%S).log"

# Rotate logs: keep last 10 per session
existing_logs=$(ls -1t "$LOG_DIR/${SESSION_NAME}"-*.log 2>/dev/null || true)
if [[ -n "$existing_logs" ]]; then
    echo "$existing_logs" | tail -n +10 | while read -r old_log; do
        rm -f "$old_log"
    done
fi

# Set tab title to repo name (falls back to session name)
TAB_TITLE="${TAB_TITLE:-$SESSION_NAME}"

# Create new session, enable pipe-pane for logging, then launch the tool
# LOG_FILE is shell-escaped since tmux hands the pipe-pane command to a shell verbatim,
# and it embeds SESSION_NAME which may come straight from user input (an explicit name arg)
LOG_FILE_ESCAPED=$(printf '%q' "$LOG_FILE")
tmux new-session -d -s "$SESSION_NAME" -c "$PWD"
tmux set-option -t "$SESSION_NAME" set-titles on
tmux set-option -t "$SESSION_NAME" set-titles-string "$TAB_TITLE"
tmux pipe-pane -t "$SESSION_NAME" -o "cat >> $LOG_FILE_ESCAPED"
tmux send-keys -t "$SESSION_NAME" "$TOOL" Enter
exec tmux attach-session -t "=$SESSION_NAME"
