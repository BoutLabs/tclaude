#!/usr/bin/env bash
# tclaude-list / tgrok-list / tcodex-list - List and attach to tmux sessions
# Shows session name, status, and creation time with interactive selection
# Lists every tmux session regardless of which tool (claude/grok/codex) created it

set -euo pipefail

if ! tmux list-sessions 2>/dev/null | grep -q .; then
    echo "No tmux sessions running."
    exit 0
fi

# Collect sessions into arrays
NAMES=()
STATUSES=()
LINES=()

while IFS='|' read -r name attached windows created; do
    if [[ "$attached" -gt 0 ]]; then
        status="attached"
    else
        status="detached"
    fi
    created_time=$(date -r "$created" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "unknown")
    NAMES+=("$name")
    STATUSES+=("$status")
    LINES+=("$(printf "%-25s %-12s %-10s %s" "$name" "$status" "$windows" "$created_time")")
done < <(tmux list-sessions -F '#{session_name}|#{session_attached}|#{session_windows}|#{session_created}' 2>/dev/null)

echo "tmux Sessions"
echo "============="
printf "  %-4s %-25s %-12s %-10s %s\n" "#" "SESSION" "STATUS" "WINDOWS" "CREATED"
echo "  ----------------------------------------------------------------"

for i in "${!LINES[@]}"; do
    printf "  %-4s %s\n" "$((i + 1))" "${LINES[$i]}"
done

echo ""
read -rp "Select session [1-${#NAMES[@]}] (q to quit): " choice

if [[ "$choice" == "q" || -z "$choice" ]]; then
    exit 0
fi

if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#NAMES[@]} )); then
    echo "Invalid selection."
    exit 1
fi

SESSION="${NAMES[$((choice - 1))]}"
echo "Attaching to '$SESSION'..."
exec tmux attach-session -t "=$SESSION"
